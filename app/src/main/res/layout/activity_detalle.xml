<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Ficha del producto"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Imagen según sea fruta/verdura o la foto real capturada -->
        <ImageView
            android:id="@+id/imagenProducto"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="Tipo de producto"
            android:scaleType="fitCenter" />

        <!-- Nombre recibido desde la pantalla principal -->
        <TextView
            android:id="@+id/textoNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoPrecio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/textoTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textoUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#555555"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Sección de Información Nutricional (Fruityvice API) -->
        <LinearLayout
            android:id="@+id/contenedorNutricional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:background="@drawable/cuadro_verde_pastel"
            android:padding="16dp">

            <TextView
                android:id="@+id/tituloNutricional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Valores Nutricionales (Fruityvice)"
                android:textColor="#1B4332"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textoNutricional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:textColor="#285238"
                android:textSize="15sp"
                android:text="Consultando API Fruityvice..." />
        </LinearLayout>

        <Button
            android:id="@+id/botonVolver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver" />

    </LinearLayout>
</ScrollView>
