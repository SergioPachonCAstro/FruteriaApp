<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@drawable/fondo_fruteria">


    <!-- Título de la pantalla -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:text="La Huerta del Pecado"
        android:textColor="#285238"
        android:textSize="38sp" />

    <!-- Nombre del producto -->
    <EditText
        android:id="@+id/campoNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Nombre del producto"
        android:inputType="textCapSentences" />

    <!-- Precio por kilo -->
    <EditText
        android:id="@+id/campoPrecio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Precio por kilo (€)"
        android:inputType="numberDecimal" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecciona el tipo de producto"
        android:textSize="16sp" />

    <!-- Permite seleccionar fruta o verdura -->
    <RadioGroup
        android:id="@+id/grupoTipo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/opcionFruta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fruta" />

        <RadioButton
            android:id="@+id/opcionVerdura"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Verdura" />

    </RadioGroup>

    <Button
        android:id="@+id/botonAnadir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Añadir producto" />

    <Button
        android:id="@+id/botonCatalogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Ver catálogo" />

</LinearLayout>