<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/fondo_fruteria">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <!-- Título de la pantalla -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:text="La Huerta del Pecado"
            android:textColor="#285238"
            android:textSize="32sp" />

        <!-- Nombre del producto -->
        <EditText
            android:id="@+id/campoNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Nombre del producto"
            android:inputType="textCapSentences" />

        <!-- Precio por kilo -->
        <EditText
            android:id="@+id/campoPrecio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Precio por kilo (€)"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona el tipo de producto"
            android:textSize="14sp" />

        <!-- Permite seleccionar fruta o verdura -->
        <RadioGroup
            android:id="@+id/grupoTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/opcionFruta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fruta" />

            <RadioButton
                android:id="@+id/opcionVerdura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="Verdura" />

        </RadioGroup>

        <!-- Botones de Foto (Cámara y Galería) ajustados -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/botonCamara"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="Cámara"
                android:textColor="#1B4332"
                android:textStyle="bold"
                android:background="@drawable/boton_verde_pastel"
                android:backgroundTint="@null" />

            <Button
                android:id="@+id/botonGaleria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="Galería"
                android:textColor="#1B4332"
                android:textStyle="bold"
                android:background="@drawable/boton_verde_pastel"
                android:backgroundTint="@null" />
        </LinearLayout>

        <!-- Vista previa de la foto seleccionada -->
        <ImageView
            android:id="@+id/ivFoto"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            android:scaleType="centerCrop" />

        <!-- Botón de ubicación GPS ajustado -->
        <Button
            android:id="@+id/botonUbicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="Obtener Ubicación GPS"
            android:textColor="#1B4332"
            android:textStyle="bold"
            android:background="@drawable/boton_verde_pastel"
            android:backgroundTint="@null" />

        <TextView
            android:id="@+id/textoUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Sin ubicación"
            android:textColor="#285238"
            android:textSize="14sp" />

        <!-- Botón Añadir producto ajustado -->
        <Button
            android:id="@+id/botonAnadir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="Añadir producto"
            android:textColor="#1B4332"
            android:textStyle="bold"
            android:background="@drawable/boton_verde_pastel"
            android:backgroundTint="@null" />

        <!-- Botón Ver catálogo ajustado -->
        <Button
            android:id="@+id/botonCatalogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="Ver catálogo"
            android:textColor="#1B4332"
            android:textStyle="bold"
            android:background="@drawable/boton_verde_pastel"
            android:backgroundTint="@null" />

    </LinearLayout>
</ScrollView>
